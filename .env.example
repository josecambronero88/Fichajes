# Copia este archivo como ".env" y rellena los valores reales.

# Cadena de conexión a tu base de datos PostgreSQL (por ejemplo, de Neon).
DATABASE_URL=postgresql://usuario:contraseña@host/nombre_basedatos

# Puerto en el que escucha el servidor (Render lo asigna solo; en local usa 3000).
PORT=3000

# Contraseña que se pedirá para editar trabajadores, sedes o borrar fichajes
# desde la pestaña "Configuración". Déjala vacía para no proteger esa sección.
ADMIN_PASSWORD=cambia-esta-contraseña
